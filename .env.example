NODE_ENV=development
API_PORT=4007
WEB_PORT=3007
API_URL=http://localhost:4007
WEB_URL=http://localhost:3007
NEXT_PUBLIC_API_URL=http://localhost:4007/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4007

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=postgresql://cf:cf@localhost:5434/creatorforce

# â”€â”€ Redis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_URL=redis://localhost:6380

# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXTAUTH_URL=http://localhost:3007
NEXTAUTH_SECRET=change-me-in-production-min-32-chars

# â”€â”€ WebAuthn / Passkeys â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required for passkey (biometric) sign-in. rpId must match the domain users visit.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AI CreatorForce
# Frontend origin used to verify passkey responses â€” must match the browser's origin exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3007

# â”€â”€ JWT (worker service auth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=900

# â”€â”€ YouTube / Google OAuth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Setup checklist (https://console.cloud.google.com/):
#   1. Create a project â†’ APIs & Services â†’ Enable "YouTube Data API v3"
#   2. APIs & Services â†’ Credentials â†’ Create OAuth 2.0 Client ID (Web application)
#   3. Authorised redirect URIs: http://localhost:4007/api/v1/channels/oauth/callback
#   4. OAuth consent screen: add scopes openid, email, profile, youtube.readonly, youtube.upload
#   5. If app is in "Testing" mode, add your Google account as a test user
#   6. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
YOUTUBE_API_KEY=

# â”€â”€ Social Sign-In: Google â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Optional override â€” falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above if unset.
# Use these when you want a separate OAuth client for social sign-in vs YouTube channel connection.
AUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# â”€â”€ Social Sign-In: Apple â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Setup: https://developer.apple.com/account/resources/identifiers/list/serviceId
#   1. Create an App ID with "Sign in with Apple" capability.
#   2. Create a Services ID (this is APPLE_CLIENT_ID), enable Sign in with Apple.
#   3. Register your redirect URI (e.g. https://yourdomain.com/auth/apple/return).
#   4. Create a Key with Sign in with Apple enabled; download the .p8 file.
#   5. Note the Team ID, Key ID, and paste the .p8 file contents below (replace newlines with \n).
APPLE_CLIENT_ID=com.yourapp.service
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# PEM private key (.p8 contents). Newlines may be stored as literal \n sequences.
APPLE_PRIVATE_KEY=

# â”€â”€ Social Sign-In: Facebook â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Setup: https://developers.facebook.com/apps/
#   1. Create an app â†’ Add "Facebook Login" product.
#   2. Set Valid OAuth Redirect URIs to your callback URL.
#   3. Copy App ID and App Secret below.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# â”€â”€ Shorts Studio â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Path to the yt-dlp binary used to fetch the creator's own source videos for
# the Shorts import pipeline. Leave empty if yt-dlp is on PATH.
YT_DLP_PATH=

# â”€â”€ OAuth Token Encryption â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# REQUIRED â€” the API refuses to boot without it. Must be exactly 64 hex
# characters (32 bytes) and unique per environment. Left blank on purpose so a
# copy-paste of this file can never ship a predictable key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# â”€â”€ AI Providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ANTHROPIC_API_KEY=
