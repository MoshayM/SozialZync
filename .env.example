# â”€â”€ n8n â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
N8N_WEBHOOK_URL=http://localhost:5679
N8N_API_KEY=

# Dev-only: allow clearly-labelled offline placeholder media (silent-ish synth voice,
# chord-pad music, gradient images) when no real provider key is configured.
# Default OFF: stages FAIL rather than fabricate output (see docs/audit-placeholders.md).
ALLOW_OFFLINE_MEDIA=false

# RBAC role elevation (billing spec Â§9.2) â€” comma-separated, case-insensitive
SUPER_ADMIN_EMAILS=sozialzync@gmail.com,ethonanpasumvalki@gmail.com
OWNER_EMAILS=

# Wallet credit conversion (billing spec Â§5.2): credits granted per 1 USD
CREDITS_PER_USD=100

# Reserveâ†’settle credit holds (billing spec Â§5.3) â€” off by default so
# zero-credit local deployments keep working; flip on to enforce
BILLING_ENFORCE_CREDITS=false
AI_CREDIT_MARKUP=2
JOB_RESERVE_CREDITS=50
COPILOT_RESERVE_CREDITS=5
HOLD_TTL_MINUTES=120

# Credit lot expiry (billing spec Â§5.4) â€” days until each bucket expires; purchased never expires
CREDIT_TTL_PROMO_DAYS=30
CREDIT_TTL_BONUS_DAYS=90
CREDIT_TTL_REFERRAL_DAYS=180

# Profit protection (Phase 5 spec Â§8): minimum margin for any priced action/offer
MIN_PROFIT_MARGIN=0.3

# Free trial (Phase 6 spec Â§5) â€” credits granted on verified signup; 0 disables trials
TRIAL_CREDITS=100
TRIAL_EXPIRY_DAYS=15

# Direct-grant offer cap (Phase 6 Â§10.1) â€” free credits an offer may grant without a recharge
MAX_FREE_GRANT_CREDITS=100

# â”€â”€ Observability â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Optional static token that protects GET /metrics from public scraping.
# When set, Prometheus (and any scraper) must send: Authorization: Bearer <value>
# Leave empty in local dev to allow open access.
# METRICS_TOKEN=

# Grafana admin password for the monitoring docker-compose stack (infra/monitoring/).
# GRAFANA_ADMIN_PASSWORD=admin

# â”€â”€ Backups & Disaster Recovery â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Directory where pg_dump files are written by infra/dr/backup.sh (and backup.ps1).
# Defaults to ./backups (relative to the script's working directory) if unset.
# BACKUP_DIR=/var/backups/creatorforce

# Number of days to retain local dump files before backup.sh prunes them.
# Default: 14. Set lower in space-constrained environments.
# BACKUP_RETENTION_DAYS=14

# Optional rclone remote destination for off-site upload (S3, R2, GCS, etc.).
# Leave unset to skip remote upload and keep backups local only.
# See infra/dr/backup.sh for setup notes.
# RCLONE_REMOTE=s3:my-bucket/creatorforce-db

# AI cost spike alert threshold in USD (used in infra/monitoring/alerts.yml comment).
# Tune the threshold in alerts.yml directly; this env var documents the intended value.
# AI_COST_SPIKE_THRESHOLD_USD=10

# â”€â”€ AI Response Caching â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Enable in-memory / Redis response cache for identical AI prompts (cuts repeat costs).
AI_RESPONSE_CACHE_ENABLED=false
# TTL in ms for cached AI responses (default 5 minutes = 300000).
# AI_CACHE_TTL_MS=300000

# â”€â”€ Voice / Audio Providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Which provider to use for TTS: elevenlabs | openai | offline
VOICE_PROVIDER=offline
# ElevenLabs (https://elevenlabs.io â†’ API Keys)
ELEVENLABS_API_KEY=
VOICE_ELEVENLABS_MODEL=eleven_turbo_v2
VOICE_ELEVENLABS_VOICE_ID=
# OpenAI TTS model when VOICE_PROVIDER=openai
VOICE_OPENAI_MODEL=tts-1

# â”€â”€ Image Generation Providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Which provider: gemini | openai | offline
IMAGE_PROVIDER=offline
IMAGE_GEMINI_MODEL=imagen-3.0-generate-002
IMAGE_OPENAI_MODEL=dall-e-3

# â”€â”€ Video Generation Providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Which provider: comfyui | luma | runway | kling | veo | pika | local (ffmpeg fallback, always on)
VIDEO_PROVIDER=local
# ComfyUI (local self-hosted â€” https://github.com/comfyanonymous/ComfyUI)
COMFYUI_URL=
# Cloud video providers (activate when key is set, used as fallback after local)
LUMA_API_KEY=
RUNWAYML_API_KEY=
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=
VEO_API_KEY=
PIKA_API_KEY=
# Optional: path to a .ttf/.otf font for drawtext overlays in local video renders
FFMPEG_FONT_PATH=

# â”€â”€ Music Generation Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Which provider: suno | udio | offline
MUSIC_PROVIDER=offline
SUNO_API_KEY=
UDIO_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# â”€â”€ Media Storage & Signing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local storage directory (when STORAGE_BACKEND=local)
MEDIA_STORAGE_DIR=./uploads
# HMAC secret for signed media-access URLs (generate: openssl rand -hex 32)
MEDIA_SIGNING_SECRET=

# â”€â”€ Face Detection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Path to the facefinder binary (leave empty to skip face-based thumbnail crop).
FACEFINDER_PATH=

# â”€â”€ Compliance Cache â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# TTL in ms for cached compliance verdicts (default 10 minutes = 600000).
COMPLIANCE_CACHE_TTL_MS=600000

# â”€â”€ Auth Token Lifetimes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Days before a refresh token expires (default 30).
REFRESH_TOKEN_TTL_DAYS=30

# â”€â”€ Stripe Extended Config â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Override Stripe API base URL (leave empty to use Stripe's default).
# Useful for mocking in tests (e.g. stripe-mock).
STRIPE_API_BASE=
# Plan price overrides as JSON (keys: starter, pro, agency; values in cents USD).
# Leave empty to use the hardcoded defaults in billing.service.ts.
# PLAN_PRICES_JSON={"starter":999,"pro":2999,"agency":9999}

# â”€â”€ Referral Program Credits â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Credits earned by the referrer on each successful referral.
REFERRAL_REFERRER_CREDITS=50
# Credits earned by the newly referred user.
REFERRAL_REFERRED_CREDITS=25
# Bonus credits for reaching milestone referral counts.
REFERRAL_MILESTONE_CREDITS=200

# â”€â”€ Organisation Approval Threshold â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Minimum credit balance required before org-level AI job is auto-approved.
ORG_APPROVAL_THRESHOLD_CREDITS=100

# â”€â”€ Scheduled Jobs (toggle each independently) â”€â”€â”€â”€â”€â”€â”€â”€â”€
NOTIFICATIONS_JOBS_ENABLED=true
# Percentage of trial credits remaining that triggers a low-credit warning (0â€“100).
NOTIFICATIONS_LOW_TRIAL_PCT=20
FORECAST_JOB_ENABLED=true
BUDGET_ROLLOVER_JOB_ENABLED=true
ASSET_GC_ENABLED=true
# Days after which an unreferenced media asset is eligible for garbage collection.
ASSET_GC_GRACE_DAYS=30

# â”€â”€ Job Reaper (stall detection) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Detect and fail jobs that have been RUNNING longer than the stall threshold.
JOB_REAPER_ENABLED=true
JOB_REAPER_STALL_MINUTES=60

# â”€â”€ Dev Webhooks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Forward internal events to a local webhook receiver (e.g. ngrok tunnel) in dev.
DEV_WEBHOOKS_ENABLED=false

# â”€â”€ Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Output format: pretty (human-readable, default in dev) | json (structured, default in prod)
LOG_FORMAT=pretty

# â”€â”€ Feature Flags â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# JSON object of boolean flags, e.g. {"shorts_studio":true,"ab_testing":false}
# Leave empty to use the hardcoded defaults in features.service.ts.
# FEATURE_FLAGS={}

# â”€â”€ Redis (host+port form) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Some services read REDIS_HOST / REDIS_PORT separately from REDIS_URL.
# Only set these if your Redis client requires individual host/port variables.
# REDIS_HOST=localhost
# REDIS_PORT=6380

