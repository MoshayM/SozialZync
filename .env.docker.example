# Copy to .env and fill in values before running docker-compose up

# Database
POSTGRES_PASSWORD=changeme_in_production

# Auth
JWT_SECRET=replace_with_32_char_random_string
TOKEN_ENCRYPTION_KEY=replace_with_32_char_hex_string
PROVIDER_KEY_SECRET=replace_with_32_char_hex_string

# URLs
WEB_URL=http://localhost:3007
API_URL=http://localhost:4007/api/v1

# Optional: self-hosted AI providers
OLLAMA_URL=http://host.docker.internal:11434
COMFYUI_URL=http://host.docker.internal:8188
A1111_URL=http://host.docker.internal:7860
KOKORO_URL=http://host.docker.internal:8880
PIPER_URL=http://host.docker.internal:5000

# Optional: cloud providers (leave blank to use only local AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_KEY=
