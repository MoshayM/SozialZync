{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @cf/tsconfig --filter @cf/shared build && pnpm --filter @cf/web build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/internal/keep-warm",
      "schedule": "*/5 * * * *"
    }
  ]
}
