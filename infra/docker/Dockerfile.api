# syntax=docker/dockerfile:1
FROM node:22-slim AS base

RUN npm install -g pnpm@11 \
 && apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# pnpm v11: set fetch timeout + persistent store via .npmrc (config set
# no longer accepts network-timeout; fetch-timeout is the correct key)
RUN printf "fetch-timeout=600000\nfetch-retries=3\n" >> /root/.npmrc \
 && pnpm config set store-dir /pnpm-store

WORKDIR /app

# Copy workspace manifests for layer caching
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/agents/package.json ./packages/agents/
COPY packages/prompts/package.json ./packages/prompts/
COPY packages/config/ ./packages/config/
COPY apps/api/package.json ./apps/api/

# BuildKit cache mount: pnpm store persists between builds so packages are
# downloaded once and reused on subsequent rebuilds.
RUN --mount=type=cache,id=sozialzynk-pnpm,target=/pnpm-store \
    pnpm install --frozen-lockfile

# Copy source
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Build shared → then API (4 GB heap: tsc on large monorepos exceeds default 1.5 GB)
RUN NODE_OPTIONS="--max-old-space-size=2560" pnpm --filter @cf/shared build \
 && NODE_OPTIONS="--max-old-space-size=2560" pnpm --filter @cf/api build

ENV NODE_ENV=production
EXPOSE 4007

CMD ["sh", "-c", "cd apps/api && npx prisma migrate deploy && node dist/main"]
