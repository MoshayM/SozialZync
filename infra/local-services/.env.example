# Local AI service URLs for CreatorForce
# Copy the vars you need into apps/api/.env
# Start services: docker compose --profile all up -d
# (or --profile tts / --profile image / --profile music / --profile video)

# ── Voice / TTS ──────────────────────────────────────────────────────────────
# Kokoro (best quality, ElevenLabs-level, CPU-friendly)
# GitHub: remsky/Kokoro-FastAPI
KOKORO_URL=http://localhost:8880

# Coqui TTS (XTTS-v2, voice cloning)
# GitHub: coqui-ai/TTS
COQUI_URL=http://localhost:5002

# Fish Speech (fast, multilingual, cloning)
# GitHub: fishaudio/fish-speech
FISH_SPEECH_URL=http://localhost:8080

# StyleTTS2 and Piper (lightweight alternatives)
# STYLETTS2_URL=http://localhost:8882
# PIPER_URL=http://localhost:8883

# ── Image Generation ─────────────────────────────────────────────────────────
# ComfyUI (SDXL, Flux, SD3 — node-based, also handles video via SVD)
# GitHub: comfyanonymous/ComfyUI
COMFYUI_URL=http://localhost:8188

# Automatic1111 / Forge WebUI (--api flag required)
# GitHub: AUTOMATIC1111/stable-diffusion-webui
# A1111_URL=http://localhost:7860

# ── Music Generation ─────────────────────────────────────────────────────────
# Local MusicGen via AudioCraft FastAPI (musicgen-server.py in this folder)
# GitHub: facebookresearch/audiocraft
MUSICGEN_URL=http://localhost:7861

# ── Offline placeholder fallback ─────────────────────────────────────────────
# Without real providers, generation FAILS rather than fabricating output.
# Set true only for local dev testing when no services are running.
# ALLOW_OFFLINE_MEDIA=true
