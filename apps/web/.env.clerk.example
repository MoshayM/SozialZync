# Clerk Authentication — https://clerk.com/docs/quickstarts/nextjs
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Custom URLs (optional — Clerk defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# NestJS backend (for ClerkAuthGuard JWKS fetch)
CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
